{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "dynamicImport": true
    },
    "target": "es2020",
    "loose": false,
    "externalHelpers": false,
    "keepClassNames": true
  },
  "module": {
    "type": "es6",
    "strict": true,
    "strictMode": true,
    "resolveFully": true
  },
  "minify": false,
  "sourceMaps": false,
  "exclude": ["node_modules", "dist", "build", "coverage", ".*\\.test\\.ts$"]
}
